{"source":"Wilson Way – Te Recuerdo, CC BY-SA, jamendo.com/track/1249933 (JamendoLyrics): rapped verses, then the sung chorus","window":[12,66],"lines":[{"index":1,"t":12.55,"text":"hola que tal espero que estés bien"},{"index":2,"t":15.17,"text":"no dejo de pensar en ti espero que tu también"},{"index":3,"t":18.33,"text":"yo estoy muy bien no niego que un poco triste"},{"index":4,"t":21.35,"text":"no saco de mi cabeza lo que tu me prometiste"},{"index":5,"t":24.42,"text":"si algo sentiste a veces me pongo a pensar"},{"index":6,"t":27.53,"text":"si verdaderamente conmigo querias estar"},{"index":7,"t":30.41,"text":"pero no vo' a negar que todavia te quiero"},{"index":8,"t":33.68,"text":"aunque ha pasado tiempo en mis brazos te espero"},{"index":9,"t":36.77,"text":"pues hay muchos recuerdos que yo tengo en mi mente"},{"index":10,"t":39.64,"text":"mis palabras mienten si dicen que nada sienten"},{"index":11,"t":42.92,"text":"presente en tu vida para siempre quisiera estar"},{"index":12,"t":46.18,"text":"juntos caminar y a tu lado despertar"},{"index":13,"t":50.06,"text":"y no puedo soportarlo mas no puedo estar no puedo estar sin ti"},{"index":14,"t":58.88,"text":"cuando te vi por primera vez te vi por primera vez"},{"index":15,"t":65.03,"text":"no pensé que me rendiria a tus pies"}],"entry":{"format":1,"lyricsHash":"fixture","created":"2026-10-17T00:00:00Z","sonata":"0.15.41-dev.1","model":"sonata-notes 2026-10-17","key":{"name":"B minor","fifths":2,"mode":"minor"},"tuning":{"cents":-0.2,"strength":0.513},"confidence":{"overall":0.824},"bars":[],"duration":66,"syl":[[13.45,13.49,"ho",1,0,2],[13.49,13.53,"la",1,1,2],[13.53,13.59,"que",1,0,1],[13.59,13.65,"tal",1,0,1],[13.71,13.87,"es",1,0,3],[13.87,14.05,"pe",1,1,3],[14.05,14.11,"ro",1,2,3],[14.19,14.29,"que",1,0,1],[14.31,14.41,"es",1,0,2],[14.41,14.55,"tés",1,1,2],[14.63,14.91,"bien",1,0,1],[15.19,15.25,"no",2,0,1],[15.29,15.37,"de",2,0,2],[15.37,15.45,"jo",2,1,2],[15.51,15.55,"de",2,0,1],[15.61,15.77,"pen",2,0,2],[