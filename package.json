{
  "name": "apple-music-for-linux",
  "author": "Marcus Tomlinson",
  "version": "0.15.30",
  "description": "Apple Music for Linux",
  "main": "main.js",
  "scripts": {
    "start": "bash start.sh",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --linux AppImage",
    "dist:appimage": "electron-builder --linux AppImage",
    "dist:snap": "electron-builder --linux snap"
  },
  "build": {
    "electronVersion": "42.3.3+wvcus",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "appId": "io.github.MarcelineVPQ.Sonata",
    "productName": "Sonata",
    "files": [
      "main.js",
      "miniplayer.html",
      "lyrics.html",
      "visualizer.html",
      "settings.html",
      "lastfm.js",
      "discord.js",
      "visualizer.js",
      "palette.js",
      "css-replacer.js",
      "preload-rail.js",
      "rail-model.js",
      "rail-ui.js",
      "rail.css",
      "lyrics-sources.js",
      "lyrics-timing.js",
      "lyrics-view.js",
      "lyrics-view.css",
      "lyrics-syllables.js",
      "!node_modules/hyphen/*/index.js",
      "!node_modules/hyphen/{CHANGELOG,README.md,bower.json,export-contract.js}",
      "!node_modules/hyphen/patterns/!(en-us|en-gb|de-1996|fr|es|it|pt|nl|sv|da|nb|fi|pl|cs|sk|hu|ro|tr|id|ca|hr|sl).js",
      "toasters.js",
      "assets/toaster/toaster_0.png",
      "assets/toaster/toaster_1.png",
      "assets/toaster/toaster_2.png",
      "assets/toaster/toaster_3.png",
      "assets/toaster/toaster_4.png",
      "assets/toaster/toaster_5.png",
      "assets/toaster/toaster_6.png",
      "assets/toaster/toaster_7.png",
      "assets/toaster/toast.png",
      "lyrics-store.js",
      "audio-listen.js",
      "listen-session.js",
      "vocal-detect.js",
      "timing-refine.js",
      "align-session.js",
      "align-helper.js",
      "align/server.py",
      "align/sonata_align.py",
      "align/sonata-align",
      "align/install.sh",
      "align/requirements.txt",
      "update-feed.js",
      "sonata.png"
    ],
    "asarUnpack": [
      "align/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "sonata.png",
      "category": "AudioVideo;Audio",
      "artifactName": "sonata-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "apple-music-for-linux"
        }
      }
    },
    "snap": {
      "grade": "stable",
      "confinement": "strict",
      "plugs": [
        "audio-playback",
        "browser-support",
        "desktop",
        "desktop-legacy",
        "home",
        "network",
        "opengl",
        "x11"
      ],
      "slots": [
        {
          "mpris": {
            "name": "chromium"
          }
        }
      ]
    }
  },
  "repository": "https://github.com/MarcelineVPQ/apple-music-for-linux",
  "license": "GPL-3.0",
  "devDependencies": {
    "electron": "https://github.com/castlabs/electron-releases#v42.3.3+wvcus",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "hyphen": "1.14.1"
  }
}
