{
  "name": "apple-music-for-linux",
  "author": "Marcus Tomlinson",
  "version": "0.15.46-dev.1",
  "description": "Apple Music for Linux",
  "main": "main.js",
  "scripts": {
    "start": "bash start.sh",
    "test": "node --test test/*.test.js",
    "gates": "node tools/verdicts.js --check && node tools/hardcodes.js --check && node tools/set-version.js --verify && node tools/doc-gates.js --check",
    "dist": "electron-builder --linux AppImage",
    "dist:appimage": "electron-builder --linux AppImage",
    "dist:snap": "electron-builder --linux snap"
  },
  "build": {
    "electronVersion": "45.0.0-alpha.14+wvcus",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "appId": "io.github.MarcelineVPQ.Sonata",
    "productName": "Sonata",
    "files": [
      "main.js",
      "miniplayer.html",
      "lyrics.html",
      "cover.html",
      "cover-model.js",
      "liner-notes.html",
      "liner-notes-sources.js",
      "liner-notes-model.js",
      "disc-find.js",
      "licenses/hyphenation-NOTICES.txt",
      "visualizer.html",
      "lastfm.js",
      "discord.js",
      "visualizer.js",
      "viz-frames.js",
      "viz-paint.js",
      "palette.js",
      "css-replacer.js",
      "preload-apple.js",
      "preload-rail-view.js",
      "apple-focus.js",
      "rail.html",
      "rail-model.js",
      "rail-ui.js",
      "rail.css",
      "lyrics-sources.js",
      "recording-id.js",
      "lyrics-timing.js",
      "lyrics-view.js",
      "stage-model.js",
      "song-actions.js",
      "stage-ui.js",
      "montage-model.js",
      "montage-sources.js",
      "montage-store.js",
      "montage-ui.js",
      "lyrics-view.css",
      "lyrics-syllables.js",
      "!node_modules/hyphen/*/index.js",
      "!node_modules/hyphen/{CHANGELOG,README.md,bower.json,export-contract.js}",
      "!node_modules/hyphen/patterns/!(en-us|en-gb|de-1996|fr|es|it|pt|nl|sv|da|nb|fi|pl|cs|sk|hu|tr|ca|hr|sl).js",
      "toasters.js",
      "assets/toaster/toaster_0.png",
      "assets/toaster/toaster_1.png",
      "assets/toaster/toaster_2.png",
      "assets/toaster/toaster_3.png",
      "assets/toaster/toaster_4.png",
      "assets/toaster/toaster_5.png",
      "assets/toaster/toaster_6.png",
      "assets/toaster/toaster_7.png",
      "assets/toaster/toast.png",
      "lyrics-store.js",
      "audio-listen.js",
      "listen-session.js",
      "vocal-detect.js",
      "timing-refine.js",
      "align-session.js",
      "align-helper.js",
      "game-guard.js",
      "notes-log.js",
      "sheet-notes-model.js",
      "sheet-notes-store.js",
      "sheet-notes-ui.js",
      "sheet-notes-glyphs.js",
      "licenses/NotoMusic-OFL.txt",
      "align/install.sh",
      "align/engine.json",
      "theme.js",
      "theme.css",
      "theme-apply.js",
      "icons.js",
      "panel.html",
      "panel.css",
      "panel-ui.js",
      "panel-model.js",
      "panel-helper.js",
      "helper-install-model.js",
      "helper-installer.js",
      "engine-feed.js",
      "gpu-detect.js",
      "gfx-model.js",
      "gfx-runtime.js",
      "glow-dither.js",
      "hdr-screens.js",
      "hdr-glow.js",
      "preload-panel.js",
      "toast.html",
      "toast-ui.js",
      "notices-model.js",
      "markdown-lite.js",
      "settings-store.js",
      "json-salvage.js",
      "updater.js",
      "about-data.js",
      "curious-model.js",
      "curious-sampler.js",
      "cpu-sampler.js",
      "CHANGELOG.md",
      "BACKLOG.md",
      "wheel-volume.js",
      "mini-model.js",
      "desktop-scheme.js",
      "relaunch.js",
      "shortcuts.js",
      "shortcuts-model.js",
      "portal-shortcuts.js",
      "dbus-wire.js",
      "media-position.js",
      "update-feed.js",
      "version-display.js",
      "sonata.png",
      "sonata.svg"
    ],
    "asarUnpack": [
      "align/install.sh",
      "align/engine.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "sonata.png",
      "category": "AudioVideo;Audio",
      "artifactName": "sonata-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "StartupWMClass": "apple-music-for-linux"
        }
      }
    },
    "snap": {
      "grade": "stable",
      "confinement": "strict",
      "plugs": [
        "audio-playback",
        "browser-support",
        "desktop",
        "desktop-legacy",
        "home",
        "network",
        "opengl",
        "x11"
      ],
      "slots": [
        {
          "mpris": {
            "name": "chromium"
          }
        }
      ]
    }
  },
  "repository": "https://github.com/MarcelineVPQ/apple-music-for-linux",
  "license": "GPL-3.0",
  "devDependencies": {
    "electron": "https://github.com/castlabs/electron-releases#v45.0.0-alpha.14+wvcus",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "hyphen": "1.14.1"
  }
}
