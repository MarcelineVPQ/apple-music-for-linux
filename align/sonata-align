#!/bin/sh
# sonata-align helper launcher: runs server.py (JSON lines on stdio) in the private venv.
# Install first with ./install.sh. SONATA_ALIGN_HOME overrides ~/.local/share/sonata-align;
# XDG_DATA_HOME counts only outside another app's sandbox (a terminal inside the Codium snap sets
# it to ~/snap/codium/<rev>/.local/share). Same rule as install.sh. --print-home prints the home.
REAL_HOME="$(readlink -f "$HOME" 2>/dev/null || echo "$HOME")"
in_sandbox() {
  p="$(readlink -f "$1" 2>/dev/null || echo "$1")"
  case "$p" in
    /snap|/snap/*|/var/snap/*|/var/lib/snapd/*|"$REAL_HOME"/snap|"$REAL_HOME"/snap/*|"$REAL_HOME"/.var/app/*|/tmp/.mount_*) return 0 ;;
  esac
  return 1
}
if [ -n "$SONATA_ALIGN_HOME" ]; then
  HOME_DIR="$SONATA_ALIGN_HOME"
elif [ -n "$XDG_DATA_HOME" ] && [ "${XDG_DATA_HOME#/}" != "$XDG_DATA_HOME" ] && ! in_sandbox "$XDG_DATA_HOME"; then
  HOME_DIR="$XDG_DATA_HOME/sonata-align"
else
  HOME_DIR="$HOME/.local/share/sonata-align"
fi
if [ "$1" = "--print-home" ]; then echo "$HOME_DIR"; exit 0; fi
export SONATA_ALIGN_HOME="$HOME_DIR"
PY="$HOME_DIR/venv/bin/python"
if [ ! -x "$PY" ]; then
  if [ -L "$PY" ]; then
    echo '{"type":"error","message":"sonata-align: the venv'"'"'s python is gone ('"$(readlink "$PY")"'); rebuild it with align/install.sh --rebuild"}'
  else
    echo '{"type":"error","message":"sonata-align is not installed (run align/install.sh)"}'
  fi
  exit 1
fi
exec "$PY" -u "$(dirname "$(readlink -f "$0")")/server.py" "$@"
